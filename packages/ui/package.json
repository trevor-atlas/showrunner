{
  "name": "@showrunner/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Showrunner dashboard — the remix@next (v3 beta) run list UI. Server-side only daemon access via the typed §13 client; the browser sees rendered HTML.",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@showrunner/core": "file:../core",
    "remix": "3.0.0-beta.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
